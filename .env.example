# Copia como .env. En el servidor conviene definir estas variables en la
# configuracion de Apache/PHP en lugar de dejar el archivo en disco.

# --- Oficinas -------------------------------------------------------------
# Las oficinas que atiende el portal, en el orden en que se muestran.
QWEB_OFICINAS=ICA,CHINCHA,PISCO,NASCA

# Una variable por oficina, con formato HOST:PUERTO/SID.
QWEB_ORACLE_ICA=oracle.interno:1521/OR1
QWEB_ORACLE_CHINCHA=oracle.interno:1522/OR2
QWEB_ORACLE_PISCO=oracle.interno:1523/OR3
QWEB_ORACLE_NASCA=oracle.interno:1524/OR4

# --- Usuario de consulta --------------------------------------------------
# Cuenta de SOLO LECTURA para los reportes. La identidad de cada persona se
# verifica aparte, conectando a Oracle con su propia cuenta.
QWEB_DB_USER=USUARIO_CONSULTA
QWEB_DB_PASSWORD=CAMBIAR_PASSWORD

# --- Indice de partidas ---------------------------------------------------
# SQLite generado aparte desde Oracle. No viaja con el codigo: son datos
# registrales reales.
# PROP_SQLITE_PATH=/var/lib/qweb/prop.sqlite

# --- Contacto y apariencia ------------------------------------------------
QWEB_CORREO_SOPORTE=soporte@ejemplo.gob.pe
QWEB_CORREO_ADMIN=admin@ejemplo.gob.pe
QWEB_COLOR_FONDO=8cacc1
